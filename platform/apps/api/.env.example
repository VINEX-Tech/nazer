# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=sqlite:///./nazer.db

# One key per device, as DEVICE_ID:key pairs separated by commas.
# Generate each key with: openssl rand -hex 24. Never reuse a key.
NAZER_DEVICE_KEYS=NAZER_XXXXXXXX:replace_with_device_key

# Signs driver bearer tokens. Without it a random secret is used and every
# session ends when the server restarts.
NAZER_TOKEN_SECRET=replace_with_random_secret
NAZER_TOKEN_TTL_HOURS=168

# HTTP Basic Auth credentials for /v1/admin/*.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_long_random_password

# Optional path to the read-only road index (built by scripts/build_speed_limits.py)
SPEED_LIMITS_DB=app/data/speed_limits.sqlite
