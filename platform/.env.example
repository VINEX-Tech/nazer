# Root .env, read by docker-compose.prod.yml. Copy to .env and fill in real
# values. Never commit .env. Per-app files (apps/api/.env, apps/web/.env)
# are only needed for native (non-Docker) development.

# One key per device, as DEVICE_ID:key pairs separated by commas. A key only
# works for its own device. Generate each key with: openssl rand -hex 24
NAZER_DEVICE_KEYS=NAZER_XXXXXXXX:replace_with_device_key

# Signs driver sessions for the app. Generate with: openssl rand -hex 32
NAZER_TOKEN_SECRET=replace_with_random_secret
# Session lifetime in hours (default 168 = 7 days).
NAZER_TOKEN_TTL_HOURS=168

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=https://admin.example.com

# Baked into the website's build: the API's public base URL.
VITE_API_BASE_URL=https://api.example.com

# HTTP Basic Auth credentials for /v1/admin/*. Required: if unset, admin
# endpoints reject every request (fail closed). Use a long random password.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_long_random_password
